@echo off
:: MatrixRain.bat - Matrix-style green character rain in the terminal
powershell -NoExit -ExecutionPolicy Bypass -Command "& { $w=$Host.UI.RawUI.WindowSize.Width; $h=$Host.UI.RawUI.WindowSize.Height; $Host.UI.RawUI.BackgroundColor='Black'; $Host.UI.RawUI.ForegroundColor='Green'; Clear-Host; $cols=0..($w-2) | %%{ @{p=(Get-Random -Max $h); s=(Get-Random -Min 1 -Max 3)} }; while($true){ for($x=0; $x -lt $cols.Count; $x++){ $c=$cols[$x]; $t=($c.p+$h-3)%%$h; try{$Host.UI.RawUI.CursorPosition=New-Object System.Management.Automation.Host.Coordinates($x,$c.p)}catch{}; Write-Host ([char](Get-Random -Min 33 -Max 126)) -NoNewline -ForegroundColor Green; try{$Host.UI.RawUI.CursorPosition=New-Object System.Management.Automation.Host.Coordinates($x,$t)}catch{}; Write-Host ' ' -NoNewline; $cols[$x].p=($c.p+$c.s)%%$h }; Start-Sleep -Milliseconds 50 } }"
